{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WritePipelineLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream","logs:PutLogEvents","logs:DescribeLogStreams"],
      "Resource": [
        "arn:aws:logs:::log-group:/aws/gravisonde/pipeline",
        "arn:aws:logs:::log-group:/aws/gravisonde/pipeline:*"
      ]
    },
    {
      "Sid": "BenchmarkBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject","s3:GetObject","s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::",
        "arn:aws:s3:::/*"
      ]
    }
  ]
}
