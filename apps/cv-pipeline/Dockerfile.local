# Local development image — runs on any CPU, uses stock OpenCV + Python
# For the COOL vs Stock comparison on EC2, see Dockerfile.cool and Dockerfile.stock

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OpenCV + ffmpeg
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libsm6 libxext6 libxrender-dev libgl1-mesa-glx \
    libglib2.0-0 libgomp1 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY src/ ./src/

# Environment
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Default command (can be overridden)
CMD ["python", "-m", "src.pipeline.main"]